PORT=3000
# Used in email links and BitLabs-style URL signatures.
# On Render this can also come from RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=http://localhost:3000

# How much of each partner payment goes to the user as points. The rest stays with the app.
USER_SHARE=0.7
# Point value in USD. 0.001 means 1,000 points ≈ $1.
POINT_USD=0.001

# First cash-out minimum in USD. After the first one, method mins apply.
FIRST_CASHOUT_USD=0.50
MIN_LIGHTNING_USD=0.80
MIN_PAYPAL_USD=1.20
MIN_GIFT_USD=2.00

# Daily window for streaks and goals
TZ=America/Boise

# Demo partner (local simulator). Set to 0 to hide Demo sticker and disable simulate buttons.
DEMO_PARTNER=1
DEMO_PARTNER_SECRET=change-me-demo-secret
DEMO_PENDING_MS=1200
DEMO_PAID_MS=2200
DEMO_REJECT_RATE=0.1

# Admin page at /admin
ADMIN_PASSWORD=change-me-admin

# Google and Apple sign-in (optional). With these missing, the buttons show
# as “Coming soon” and the site still works. See AUTH-SETUP.md.
# PUBLIC_BASE_URL must match the live site when you turn these on:
# PUBLIC_BASE_URL=https://goody-dfi5.onrender.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# Optional: file contents Apple gives you to verify goody-dfi5.onrender.com
# APPLE_DOMAIN_ASSOCIATION=

# Postgres. Leave empty to use the local sql.js file at data/goody.sqlite.
# If this is missing, not a postgres:// URL, or the connection fails, the app
# starts with sql.js and logs a warning (it will not crash).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Email (optional). With none of these set, confirmation and reset links are
# printed in the server log and the app shows a friendly note.
# MAIL_FROM=Goody <noreply@example.com>
# Preferred on Render (free plan blocks outbound SMTP). HTTP API, not SMTP.
# BREVO_API_KEY=
# SMTP_URL=smtp://USER:PASSWORD@smtp.example.com:587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=

# Payout providers (optional). With keys missing, admin approval is
# “Approved, send manually.” Do not commit real keys.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# TREMENDOUS_API_KEY=
# TREMENDOUS_CAMPAIGN_ID=
# TREMENDOUS_FUNDING_SOURCE_ID=BALANCE
# TREMENDOUS_ENV=testflight
# ZBD_API_KEY=
# ZEBEDEE_API_KEY=
# BTC_USD=

# Real offerwall partners — leave empty until you have accounts. See PARTNERS.md.
BITLABS_SECRET=
ADGEM_POSTBACK_KEY=
CPX_SECURE_HASH=
# TODO: confirm official Ayet Studios signature before going live
AYET_SECRET=
TOROX_SECRET=
LOOTABLY_POSTBACK_SECRET=
# TODO: confirm official TheoremReach HMAC and parameter names before going live
THEOREMREACH_SECRET=
