PORT=3000
# Used in links and BitLabs-style URL signatures if you test behind a proxy
PUBLIC_BASE_URL=http://localhost:3000

# How much of each partner payment goes to the user as points. The rest stays with the app.
USER_SHARE=0.7
# Point value in USD. 0.001 means 1,000 points ≈ $1.
POINT_USD=0.001

# First cash-out minimum in USD. After the first one, method mins apply.
FIRST_CASHOUT_USD=0.50
MIN_LIGHTNING_USD=0.80
MIN_PAYPAL_USD=1.20
MIN_GIFT_USD=2.00

# Daily window for streaks and goals
TZ=America/Boise

# Demo partner (local simulator). Set to 0 to hide Demo sticker and disable simulate buttons.
DEMO_PARTNER=1
DEMO_PARTNER_SECRET=change-me-demo-secret
# How long the demo partner waits before "checking" and before paying (ms)
DEMO_PENDING_MS=1200
DEMO_PAID_MS=2200
DEMO_REJECT_RATE=0.1

# Admin page at /admin
ADMIN_PASSWORD=change-me-admin

# Real partners — leave empty until you have accounts. See server/config.js for param notes.
BITLABS_SECRET=
ADGEM_POSTBACK_KEY=
CPX_SECURE_HASH=
# TODO: confirm official Ayet Studios and Torox signature params before going live
AYET_SECRET=
TOROX_SECRET=
